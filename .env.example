# Copy this file to `.env` and adjust values for local runs.
# `docker compose` reads `.env` from the repository root automatically.
# Never commit `.env`. It holds local secrets and machine settings.

# MongoDB address the API connects to.
MONGO_URI=mongodb://mongo:27017

# Database name for alumni, announcements, and counters.
MONGO_DB=alumni

# Address the API binds to inside its container.
BIND_ADDR=0.0.0.0:8080

# Log level for the API (error, warn, info, debug, trace).
RUST_LOG=info
